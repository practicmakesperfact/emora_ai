# Application Settings
APP_NAME="Emora Mental Health Chatbot"
APP_VERSION="1.0.0"
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/emora_db

# JWT Settings
SECRET_KEY=your-very-secret-key-change-this-in-production-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Groq API
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant

# Ollama (for nomic-embed-text)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma

# File Storage
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=50

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# Security
BCRYPT_ROUNDS=12
